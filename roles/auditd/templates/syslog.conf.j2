{{ ansible_managed | default('Ansible managed') | comment }}
#
# Syslog Plugin Configuration
#

active = {{ 'yes' if auditd_plugin_syslog_enabled | bool else 'no' }}
direction = out
path = /sbin/audisp-syslog
type = always
args = {{ auditd_syslog_priority }} {{ auditd_syslog_facility }}
format = string
