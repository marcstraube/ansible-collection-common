{{ ansible_managed | default('Ansible managed') | comment }}

[Unit]
Description=AIDE File Integrity Check
Documentation=man:aide(1)
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/aide-check.sh
# AIDE exit codes 1-7 report changes (1 added, 2 removed, 4 changed entries),
# not a failure; errors of AIDE (14 and above) and of the script still fail
SuccessExitStatus=1 2 3 4 5 6 7
StandardOutput=journal
StandardError=journal
Nice=19
IOSchedulingClass=idle
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
