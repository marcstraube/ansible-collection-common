{{ ansible_managed | comment }}
# Local override for the packaged php-fpm AppArmor profile.
#
# The profile attaches to /usr/bin/php-fpm* and therefore also confines
# the versioned variants (php-fpm84, ...), but the stock php abstraction
# only permits the unversioned config paths. Allow the versioned config
# trees, runtime directories and sockets.
/etc/php[0-9]*/** r,
@{run}/php[0-9]*-fpm/ rw,
@{run}/php[0-9]*-fpm/*.sock{,et} rwlk,
@{run}/php[0-9]*-fpm.pid rw,

# Without session.save_path and upload_tmp_dir (Arch Linux) PHP keeps
# session files and uploads in /tmp (private to the service); the stock
# profile only covers /var/lib/php. The session garbage collection lists the
# directory.
/tmp/ r,
owner /tmp/sess_* rwk,
owner /tmp/php* rw,
{% if __php_fpm_sockets | default([]) %}

# Sockets of the named pools. The stock profile and the rules above cover the
# default socket directories; these rules also cover a pool whose listen path
# points elsewhere.
{% for __socket in __php_fpm_sockets | unique | sort %}
"{{ __socket }}" rwlk,
{% endfor %}
{% endif %}
