{{ ansible_managed | default('Ansible managed') | comment }}
#
# rkhunter rootkit check systemd service
#

[Unit]
Description=rkhunter Rootkit Check
Documentation=man:rkhunter(8)
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/rkhunter-check.sh
# Exit code 1: the scan ran and found warnings, which rkhunter reports itself
# (log, syslog, MAIL-ON-WARNING); every other non-zero code fails the unit.
# rkhunter-check.sh exits with 2 when the configuration check fails.
SuccessExitStatus=1
StandardOutput=journal
StandardError=journal

# Scheduling priority
Nice=19
IOSchedulingClass=idle

# Security hardening
# Note: rkhunter needs read access to the entire filesystem, so no option that
# hides or replaces paths it checks (ProtectKernelModules hides
# /usr/lib/modules, ProtectHome, PrivateTmp, PrivateDevices)
ProtectKernelTunables=true
# Module loading blocked without ProtectKernelModules, which would hide
# /usr/lib/modules from the kernel module check
CapabilityBoundingSet=~CAP_SYS_MODULE
SystemCallFilter=~@module
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
NoNewPrivileges=true
RestrictRealtime=true
RestrictSUIDSGID=true
MemoryDenyWriteExecute=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
